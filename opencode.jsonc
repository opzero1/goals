{
	"$schema": "https://opencode.ai/config.json",
	// Repo-scoped dev loading: any opencode session started inside this repo
	// loads the goals SERVER plugin from TypeScript source (no build step;
	// restart opencode to reload). The TUI half is registered in ./tui.json.
	// Project config merges with ~/.config/opencode/opencode.json, so this
	// only affects sessions in this repo.
	"plugin": ["./dev/server.ts"]
}
