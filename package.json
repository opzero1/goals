{
	"name": "@op1/goals",
	"version": "0.1.0",
	"description": "Goal tracking plugin for OpenCode with slash commands, model tools, and guarded continuation",
	"type": "module",
	"main": "dist/goals.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/goals.js"
		},
		"./server": {
			"types": "./dist/server.entry.d.ts",
			"import": "./dist/server.js"
		},
		"./tui": {
			"types": "./dist/tui.entry.d.ts",
			"import": "./dist/tui.js"
		}
	},
	"scripts": {
		"build": "bun run scripts/build.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap false",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"dev": "bun run scripts/dev-sandbox.ts"
	},
	"files": ["dist"],
	"dependencies": {
		"@opencode-ai/plugin": "^1.17.0",
		"solid-js": "^1.9.0",
		"zod": "4.1.8"
	},
	"devDependencies": {
		"@opentui/core": "0.3.4",
		"@opentui/keymap": "0.3.4",
		"@opentui/solid": "0.3.4",
		"@types/bun": "^1.1.0",
		"typescript": "^5.7.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/opzero1/goals.git"
	},
	"license": "MIT",
	"keywords": ["opencode", "plugin", "goals", "continuation"]
}
